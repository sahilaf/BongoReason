# Raw source dumps — large, and redistributable only under upstream licenses.
# Rebuild with the fetch/download scripts instead of committing.
dataset/raw/
_archive/

# Evaluation benchmarks — refetch with scripts/00_fetch_eval.py.
# NEVER commit these. They are other people's benchmarks, redistribution terms
# vary, and re-hosting eval content in a public repo is exactly how it ends up in
# someone's training crawl. This project exists partly because that happened to
# Bn-MGSM. Rebuild eval_dual_script/ with scripts/06_build_eval_sets.py.
dataset/eval/
dataset/eval_dual_script/

# Intermediate pipeline artifacts — regenerated by scripts/run_pipeline.py
dataset/interim/

# Derived and large; regenerate with scripts/04_build_script_pairs.py
dataset/script_pairs/

# The built dataset is 165 MB — over GitHub's hard 100 MB per-file limit.
# It lives on Hugging Face; rebuild locally with scripts/run_pipeline.py.
dataset/verified/

# Evaluation outputs
results/

# TRACKED ON PURPOSE (do not ignore):
#   dataset/splits/     frozen id manifests — experiments are incomparable without them
#   dataset/metadata/   stage reports and the data card
#   dataset/corrections/  90 KB, small enough to track

dataset/**/*.bak
dataset/**/*.tmp.json

# Models and checkpoints
checkpoints/
outputs/
adapters/
*.safetensors
*.gguf
*.bin
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Tooling
wandb/
.env
